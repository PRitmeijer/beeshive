# Database (SQLite file path)
DATABASE_URI=file:./database.db

# Payload CMS secret - CHANGE THIS IN PRODUCTION
PAYLOAD_SECRET=your-secret-key-here

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Outgoing mail.
#
# Reservation requests are emailed to the address in Site Instellingen ->
# Contact (info@debeeshive.nl by default). Leave SMTP_HOST unset and Payload
# writes messages to the console instead of sending them, which is what you
# want locally: nothing is lost, and a booking is never rejected because a mail
# server was unreachable.
#
# SMTP_SECURE is inferred from the port when omitted: 465 is implicit TLS,
# 587 upgrades with STARTTLS.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@debeeshive.nl
# SMTP_PASS=
# SMTP_SECURE=
# EMAIL_FROM=no-reply@debeeshive.nl
# EMAIL_FROM_NAME=De Bee's Hive
