# Database.
#
# PostgreSQL, not SQLite: the site moved over so that backups, concurrent
# writes and point-in-time recovery stop being wishes. Left unset, the config
# falls back to the local development database that docker-compose or the
# "beeshive-pg" container serves on 5433, so `npm run dev` works with no .env
# at all.
#
# In Docker this variable is built from the POSTGRES_* below and points at the
# `postgres` service; you do not set it there.
DATABASE_URI=postgresql://beeshive:beeshive@localhost:5433/beeshive

# The database container's own credentials. Only Docker reads these, and they
# have to agree with DATABASE_URI — Compose builds that URL out of them. The
# defaults are fine on a machine where nothing but Docker can reach the
# database; change POSTGRES_PASSWORD on anything that is not a laptop.
# Changing them after the first start does NOT change the existing cluster: the
# user is created by initdb, once, and the volume keeps it.
# POSTGRES_USER=beeshive
# POSTGRES_PASSWORD=beeshive
# POSTGRES_DB=beeshive

# Payload CMS secret - CHANGE THIS IN PRODUCTION
PAYLOAD_SECRET=your-secret-key-here

# Host port the container is published on; Docker only. Nginx Proxy Manager
# forwards to beeshive on this port — beeshive being the host, not the
# container — so it must match that Proxy Host's Forward Port exactly.
# 3000 is occupied on the production host: set this there.
# HOST_PORT=3000

# How many proxies of ours stand in front of Node.
#
# The rate limits on the reservation form, the contact form, the newsletter and
# the availability endpoint all have to decide who is asking, and behind a
# proxy the only thing they have to go on is x-forwarded-for. That header is a
# list to which each proxy APPENDS what it saw — Nginx Proxy Manager forwards
# with $proxy_add_x_forwarded_for — while everything a visitor sends arrives
# already at the front of it. So the real address is counted from the RIGHT,
# and this number says how far in: one entry per proxy of ours.
#
# Unset means 1, which is this deployment: NPM and nothing else. Behind
# Cloudflare as well it is 2. Counting too low makes every visitor share one
# throttle bucket, which is annoying and obvious; counting too high starts
# trusting entries the visitor wrote, which silently removes the throttle
# altogether. When in doubt, count low.
#
# Set 0 only when Node itself is on the public port with no proxy anywhere:
# then nothing in the header can be believed, and the whole site shares a
# single bucket.
# TRUSTED_PROXY_HOPS=1

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Uploads on Cloudflare R2.
#
# All four have to be present before anything is stored remotely. With any of
# them missing the site writes uploads to MEDIA_DIR (the media-uploads volume,
# or ./media locally) exactly as it always has — which is what you want on a
# laptop, and means a test host without a bucket still works. Set some but not
# all and you get the local behaviour, not an error.
#
# R2_ENDPOINT is the S3 API address from the R2 dashboard, with the scheme.
#
# R2_PUBLIC_URL is the address visitors load images from, and it is a real
# decision rather than a detail. A custom domain on the bucket needs the zone's
# nameservers at Cloudflare; without that, the bucket's own r2.dev subdomain
# works and needs no DNS anywhere, at the cost of a rate limit Cloudflare does
# not publish a number for. Left unset, image URLs stay on this origin and the
# app streams each file out of the bucket itself, which is slower and cannot
# surprise you. docs/media-hosting.md lays the three out, including why none of
# them affects search.
#
# It is read at build time as well as at runtime (next.config.mjs pins the
# image optimiser to this host), so change it and rebuild.
# R2_BUCKET=beeshive-media
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://media.debeeshive.nl

# Database backups to R2, via pgBackRest. Docker only; see ops/README.md.
#
# The backup container refuses to start unless all five are set, rather than
# pretending to take backups. The endpoint here is WITHOUT the scheme, unlike
# R2_ENDPOINT above — pgBackRest wants a bare host name.
#
# PGBACKREST_CIPHER_PASS encrypts the repository before it leaves the machine.
# Generate one with `openssl rand -base64 48` and keep a copy somewhere other
# than this server: lose it and every backup in the bucket is unreadable,
# permanently.
# PGBACKREST_S3_BUCKET=beeshive-backups
# PGBACKREST_S3_ENDPOINT=<account-id>.r2.cloudflarestorage.com
# PGBACKREST_S3_KEY=
# PGBACKREST_S3_KEY_SECRET=
# PGBACKREST_CIPHER_PASS=
#
# When the nightly backup runs, in the container's local time, and which day
# gets the full one (0 = Sunday). The other nights are differentials.
# BACKUP_HOUR=3
# BACKUP_MINUTE=15
# FULL_BACKUP_DOW=0

# Visitor statistics.
#
# A read-only API key from the Umami instance, used to show visitor numbers in
# the admin. Unset simply means that panel says there are no statistics; the
# public site is unaffected and no tracking of any kind depends on it.
# UMAMI_API_KEY=

# Outgoing mail.
#
# Reservation requests are emailed to the address in Site Instellingen ->
# Contact (info@debeeshive.nl by default). Leave SMTP_HOST unset and Payload
# writes messages to the console instead of sending them, which is what you
# want locally: nothing is lost, and a booking is never rejected because a mail
# server was unreachable.
#
# SMTP_SECURE is inferred from the port when omitted: 465 is implicit TLS,
# 587 upgrades with STARTTLS.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@debeeshive.nl
# SMTP_PASS=
#
# A dollar sign in the password MUST be doubled here. Compose interpolates
# this file, so SMTP_PASS=abc$def becomes abc by the time it reaches the
# container, and Strato answers "535 Authentication failed" for a password you
# can see is correct. Write abc$$def. Check what actually arrived with:
#     docker compose exec beeshive printenv SMTP_USER SMTP_PASS
# The same trap applies to POSTGRES_PASSWORD and the R2 and pgBackRest keys.
# SMTP_SECURE=
# EMAIL_FROM=no-reply@debeeshive.nl
# EMAIL_FROM_NAME=De Bee's Hive
