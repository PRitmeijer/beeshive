{
    "name": "debeeshive",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "prebuild": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
        "build": "next build",
        "start": "next start",
        "preflight": "node ops/preflight.mjs",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "payload": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts NODE_OPTIONS=\"--import tsx\" payload --disable-transpile",
        "generate:types": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts NODE_OPTIONS=\"--import tsx\" payload --disable-transpile generate:types",
        "migrate:create": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts NODE_OPTIONS=\"--import tsx\" payload --disable-transpile migrate:create",
        "migrate": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts NODE_OPTIONS=\"--import tsx\" payload --disable-transpile migrate",
        "migrate:status": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts NODE_OPTIONS=\"--import tsx\" payload --disable-transpile migrate:status",
        "generate:importmap": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts NODE_OPTIONS=\"--import tsx\" payload --disable-transpile generate:importmap",
        "db:export": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts tsx scripts/export-content.ts",
        "db:import": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts tsx scripts/import-content.ts",
        "db:verify": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts tsx scripts/verify-import.ts",
        "seed": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts tsx scripts/seed.ts",
        "seed:en": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts tsx scripts/seed-en.ts",
        "blog:publish": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts tsx scripts/publish-blog-posts.ts",
        "blog:html": "tsx scripts/export-blog-html.ts",
        "import:subscribers": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts tsx scripts/import-subscribers.ts"
    },
    "dependencies": {
        "@payloadcms/db-postgres": "3.88.0",
        "@payloadcms/email-nodemailer": "3.88.0",
        "@payloadcms/next": "3.88.0",
        "@payloadcms/plugin-seo": "3.88.0",
        "@payloadcms/richtext-lexical": "3.88.0",
        "@payloadcms/storage-s3": "3.88.0",
        "@payloadcms/translations": "3.88.0",
        "@payloadcms/ui": "3.88.0",
        "cross-env": "7.0.3",
        "framer-motion": "11.15.0",
        "graphql": "16.9.0",
        "next": "15.4.11",
        "payload": "3.88.0",
        "react": "19.2.1",
        "react-dom": "19.2.1",
        "sharp": "0.35.4"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.3",
        "@types/node": "22.20.1",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.5",
        "@vitest/coverage-v8": "3.2.7",
        "autoprefixer": "10.4.20",
        "eslint": "9.39.5",
        "eslint-config-next": "15.4.11",
        "jsdom": "26.1.0",
        "postcss": "8.5.26",
        "tailwindcss": "3.4.16",
        "tsx": "4.23.12",
        "typescript": "5.7.2",
        "vitest": "3.2.7"
    }
}
